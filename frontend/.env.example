# ===================================================================
# BACKEND API CONFIGURATION
# ===================================================================
# The backend API base URL. 
# - Local dev: http://localhost:8000 (auto-detected if not set)
# - Production: Set this in Vercel to your Cloud Run URL
# Example: https://scopic-legal-api-566998539930.us-central1.run.app
NEXT_PUBLIC_API_BASE_URL=

# ===================================================================
# SUPABASE CONFIGURATION
# ===================================================================
# Supabase project URL (required for authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (required for authentication)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase storage bucket name for profile documents
NEXT_PUBLIC_SUPABASE_PROFILE_BUCKET=ProfileDrawer

# ===================================================================
# VERCEL DEPLOYMENT INSTRUCTIONS
# ===================================================================
# When deploying to Vercel, set these environment variables:
# 1. NEXT_PUBLIC_API_BASE_URL = https://scopic-legal-api-566998539930.us-central1.run.app
# 2. NEXT_PUBLIC_SUPABASE_URL = (your Supabase project URL)
# 3. NEXT_PUBLIC_SUPABASE_ANON_KEY = (your Supabase anon key)
# 4. NEXT_PUBLIC_SUPABASE_PROFILE_BUCKET = ProfileDrawer
# ===================================================================
