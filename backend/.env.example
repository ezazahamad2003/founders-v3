# ==================================================================
# CLOUD RUN / PRODUCTION DEPLOYMENT CONFIGURATION
# ==================================================================
# For Cloud Run deployment, set these via:
#   gcloud run deploy --set-env-vars KEY=VALUE
# Or use Secret Manager (recommended for sensitive values):
#   gcloud run deploy --set-secrets KEY=SECRET_NAME:latest
# ==================================================================

# ------------------------------------------------------------------
# OpenAI Configuration
# ------------------------------------------------------------------
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."
# Optional: Custom OpenAI-compatible endpoint (leave empty for official OpenAI)
OPENAI_BASE_URL=""

# ------------------------------------------------------------------
# Supabase Database (PostgreSQL)
# ------------------------------------------------------------------
# Get from: Supabase Dashboard → Project Settings → Database → Connection String
# Format: postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL="postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ------------------------------------------------------------------
# Supabase Authentication
# ------------------------------------------------------------------
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_PROJECT_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="eyJhbGci..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."
# Get from: Supabase Dashboard → Project Settings → API → JWT Settings
SUPABASE_JWKS_URL="https://PROJECT_REF.supabase.co/auth/v1/certs"
SUPABASE_JWT_SECRET="your-jwt-secret"

# ------------------------------------------------------------------
# Supabase Storage
# ------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET_NAME="uploads"
SUPABASE_STORAGE_PUBLIC_BASE_URL="https://PROJECT_REF.supabase.co/storage/v1/object/public"

# ------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------
# Environment: "local" | "production"
APP_ENV="local"
# Comma-separated list of allowed CORS origins
# Production example: "https://yourdomain.com,https://www.yourdomain.com"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002"
# Max conversation history to send to LLM (controls token usage)
MAX_HISTORY_MESSAGES="30"
# Max tokens for LLM completion
MAX_OUTPUT_TOKENS="4096"

# ------------------------------------------------------------------
# OpenAI Model Selection
# ------------------------------------------------------------------
# Model for standard chat (recommended: gpt-4o-mini for cost, gpt-4o for quality)
OPENAI_MODEL_CHAT="gpt-4o-mini"
# Model for vision/image analysis (must support vision)
OPENAI_MODEL_VISION="gpt-4o-mini"
# Model for deep research mode (can use more powerful model)
OPENAI_MODEL_DEEP_RESEARCH="gpt-4o"
