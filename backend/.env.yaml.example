APP_ENV: "production"
PYTHONUNBUFFERED: "1"
OPENAI_API_KEY: "your-openai-api-key-here"
OPENAI_BASE_URL: ""
OPENAI_MODEL_CHAT: "gpt-5.1"
OPENAI_MODEL_VISION: "gpt-4.1-mini"
OPENAI_MODEL_DEEP_RESEARCH: "gpt-4.1"
SUPABASE_DB_URL: "your-supabase-db-url-here"
SUPABASE_JWKS_URL: "https://your-project.supabase.co/auth/v1/certs"
SUPABASE_JWT_SECRET: "your-jwt-secret-here"
SUPABASE_ANON_KEY: "your-anon-key-here"
SUPABASE_STORAGE_PUBLIC_BASE_URL: "https://your-project.supabase.co/storage/v1/object/public"
SUPABASE_STORAGE_BUCKET_NAME: "uploads"
ALLOWED_ORIGINS: "https://your-frontend.vercel.app/,http://localhost:3000"
MAX_HISTORY_MESSAGES: "30"
MAX_OUTPUT_TOKENS: "4096"
NEXT_PUBLIC_SUPABASE_PROFILE_BUCKET: "ProfileDrawer"
